{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2017",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@peerlab/core/management-shell-browser/shared-ui/*": [
        "libs/core/management-shell-browser/shared-ui/src/lib/*"
      ],
      "@peerlab/docusaurus": [
        "teams/kernel/docusaurus/src/index.ts"
      ],
      "@peerlab/kernel/management-shell-browser/*": [
        "teams/kernel/management-shell-browser/src/*"
      ],
      "@peerlab/kernel/shared-ts-utils/*": [
        "teams/kernel/shared-ts-utils/src/*"
      ],
      "@peerlab/kernel/shared-ui-components/*": [
        "teams/kernel/shared-ui-components/src/*"
      ],
      "@peerlab/kernel/taxonomic-units/base/*": [
        "teams/kernel/taxonomic-units/base/src/*"
      ],
      "@peerlab/people/organizations-management/base/*": [
        "teams/people/organizations-management/base/src/*"
      ],
      "@peerlab/researchers/peers/adapters/*": [
        "libs/researchers/peers/adapters/src/*"
      ],
      "@peerlab/researchers/peers/core/*": [
        "libs/researchers/peers/core/src/*"
      ],
      "@peerlab/root/*": [
        "./*"
      ],
      "@peerlab/things/assets-catalog/base/*": [
        "teams/things/assets-catalog/base/src/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}