{
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.formatOnSave": true,
  "files.associations": {
    "CODEOWNERS": "no-auto-format"
  },
  "[no-auto-format]": {
    "editor.formatOnSave": false
  },
  "cSpell.words": [
    "branchset",
    "Cladogram",
    "kafkajs",
    "nestjs",
    "Partitioner",
    "Partitioners",
    "zitadel"
  ],
  "eslint.validate": [
    "json"
  ],
  "watch.exclude": {
    "**/node_modules": true,
    "**/dist": true
  },
  "testing.automaticallyOpenPeekView": "never"
}