{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug people-skill-set-browser App",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/teams/people/skill-set/browser"
    },
    {
      "name": "Debug kernel-management-shell-browser App",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/teams/kernel/management-shell-browser"
    },
    {
      "name": "Debug Express App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/teams/people/organizations-management",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "nx",
        "run",
        "people-organizations-management-rest-api:serve"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/teams/people/organizations-management/**/*.js"
      ]
    },
    {
      "name": "Test Express App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/teams/people/organizations-management",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "nx",
        "run",
        "people-organizations-management-base:test"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/teams/people/organizations-management/**/*.js"
      ]
    },
    {
      "name": "Inspect Browser App",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/teams/people/skill-set/browser",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "nx",
        "run",
        "people-skill-set-browser:serve"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/dist/teams/people/skill-set/browser/**/*.js"
      ]
    },
    {
      "name": "Attach to Service",
      "request": "attach",
      "cwd": "${workspaceFolder}/apps",
      "type": "node",
    }
  ]
}