{
  "name": "people-skill-set-browser",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "teams/people/skill-set/browser/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/teams/people/skill-set/browser",
        "postcssConfig": "teams/web/postcss.config.js"
      },
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "mode": "production"
        }
      }
    },
    "serve": {
      "executor": "@nx/vite:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "people-skill-set-browser:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "people-skill-set-browser:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "people-skill-set-browser:build:production",
          "hmr": false
        }
      }
    },
    "preview": {
      "executor": "@nx/vite:preview-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "people-skill-set-browser:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "people-skill-set-browser:build:development"
        },
        "production": {
          "buildTarget": "people-skill-set-browser:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "outputs": [
        "{workspaceRoot}/coverage/teams/people/skill-set/browser"
      ],
      "options": {
        "passWithNoTests": true,
        "reportsDirectory": "../../../coverage/teams/people/skill-set/browser"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "docker-build": {
      "command": "docker build -f teams/people/skill-set/browser/Dockerfile . -t people-skill-set-browser",
      "dependsOn": [
        "build"
      ]
    },
    "docker-run": {
      "command": "docker run --rm -p 80:80 people-skill-set-browser"
    }
  },
  "tags": []
}