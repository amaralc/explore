{
  "name": "people-researchers-peers-svc-consumer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "teams/people/researchers-peers-svc/consumer/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/teams/people/researchers-peers-svc/consumer",
        "main": "teams/people/researchers-peers-svc/consumer/src/main.ts",
        "tsConfig": "teams/people/researchers-peers-svc/consumer/tsconfig.app.json",
        "assets": ["teams/people/researchers-peers-svc/consumer/src/assets"],
        "webpackConfig": "teams/people/researchers-peers-svc/consumer/webpack.config.js",
        "babelUpwardRootMode": true
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "people-researchers-peers-svc-consumer:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "people-researchers-peers-svc-consumer:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "teams/people/researchers-peers-svc/consumer/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  }
}
