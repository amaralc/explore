{
  "name": "docusaurus",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "teams/kernel/docusaurus/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/teams/kernel/docusaurus",
        "main": "teams/kernel/docusaurus/src/index.ts",
        "tsConfig": "teams/kernel/docusaurus/tsconfig.lib.json",
        "assets": [
          "teams/kernel/docusaurus/*.md",
          {
            "input": "./teams/kernel/docusaurus/src",
            "glob": "**/!(*.ts)",
            "output": "./src"
          },
          {
            "input": "./teams/kernel/docusaurus/src",
            "glob": "**/*.d.ts",
            "output": "./src"
          },
          {
            "input": "./teams/kernel/docusaurus",
            "glob": "generators.json",
            "output": "."
          },
          {
            "input": "./teams/kernel/docusaurus",
            "glob": "executors.json",
            "output": "."
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "teams/kernel/docusaurus/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    }
  },
  "tags": []
}