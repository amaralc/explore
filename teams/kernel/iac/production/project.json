{
  "name": "kernel-iac-production",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "teams/kernel/iac/production",
  "projectType": "application",
  "implicitDependencies": [
    "kernel-iac-bootstrap",
    "kernel-iac-modules-gcp-apis",
    "kernel-iac-modules-environment"
  ],
  "targets": {
    "terraform-init": {
      "command": "cd teams/kernel/iac/production && terraform init -upgrade"
    },
    "terraform-validate": {
      "command": "cd teams/kernel/iac/production && terraform validate"
    },
    "terraform-plan": {
      "command": "cd teams/kernel/iac/production && terraform plan -out=tfplan -var-file=env.tfvars"
    },
    "terraform-apply-flag-management": {
      "command": "cd teams/kernel/iac/production && terraform plan -out=tfplan -var-file=env.tfvars && terraform apply -auto-approve -target='module.production[0].module.kernel-flag-management[0]'"
    },
    "terraform-apply": {
      "command": "cd teams/kernel/iac/production && terraform apply -auto-approve tfplan && terraform output"
    },
    "terraform-destroy": {
      "command": "cd teams/kernel/iac/production && terraform destroy -var-file=env.tfvars -auto-approve"
    },
    "terraform-output": {
      "command": "cd teams/kernel/iac/production && terraform output"
    },
    "terraform-providers": {
      "command": "cd teams/kernel/iac/production && terraform providers"
    },
    "terraform-graph": {
      "command": "cd teams/kernel/iac/production && terraform graph | dot -Tsvg > graph.svg"
    }
  }
}