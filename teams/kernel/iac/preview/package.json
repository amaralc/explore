{
  "name": "kernel-iac-preview",
  "version": "1.0.0",
  "description": "Preview infrastructure as code for kernel IAC",
  "private": true,
  "type": "module",
  "scripts": {
    "preview-terraform-init": "cd teams/kernel/iac/preview && terraform init",
    "preview-terraform-validate": "cd teams/kernel/iac/preview && terraform validate",
    "preview-terraform-plan": "cd teams/kernel/iac/preview && terraform plan -out=tfplan -var-file=env.tfvars",
    "preview-terraform-apply": "cd teams/kernel/iac/preview && terraform apply -auto-approve tfplan && terraform output",
    "preview-terraform-destroy": "cd teams/kernel/iac/preview && terraform destroy -var-file=env.tfvars -auto-approve",
    "preview-terraform-output": "cd teams/kernel/iac/preview && terraform output",
    "preview-terraform-graph": "cd teams/kernel/iac/preview && terraform graph | dot -Tsvg > graph.svg"
  },
  "dependencies": {
    "kernel-iac-bootstrap": "workspace:*",
    "kernel-iac-production": "workspace:*",
    "kernel-iac-modules-gcp-apis": "workspace:*",
    "kernel-iac-modules-environment": "workspace:*"
  }
}
