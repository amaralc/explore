{
  "name": "people-organizations-management-functions",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/people/organizations-management/functions/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "platform": "node",
        "outputPath": "dist/apps/people/organizations-management/functions",
        "format": [
          "cjs"
        ],
        "bundle": false,
        "main": "apps/people/organizations-management/functions/src/main.ts",
        "tsConfig": "apps/people/organizations-management/functions/tsconfig.app.json",
        "assets": [
          "apps/people/organizations-management/functions/src/assets"
        ],
        "generatePackageJson": true,
        "esbuildOptions": {
          "sourcemap": true,
          "outExtension": {
            ".js": ".js"
          }
        }
      },
      "configurations": {
        "development": {},
        "production": {
          "minify": true,
          "bundle": true,
          "esbuildOptions": {
            "sourcemap": false,
            "outExtension": {
              ".js": ".js"
            }
          }
        }
      }
    },
    "post-build": {
      "command": "node apps/people/organizations-management/functions/post-build.js"
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "functions:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "functions:build:development"
        },
        "production": {
          "buildTarget": "functions:build:production"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/people/organizations-management/functions/jest.config.ts"
      }
    }
  },
  "tags": []
}