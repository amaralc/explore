  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "people-skill-set-browser:build": "pnpm --filter ./teams/people/skill-set/browser run build",
    "people-skill-set-browser:start": "pnpm --filter ./teams/people/skill-set/browser run start",
    "prepare": "sh setup-after-install.sh",
    "git:discard:all": "git checkout -- .",
    "release": "nx release --skip-publish",
    "release:no-push": "nx release --skip-publish --git-commit=false --git-tag=false",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "release:publish": "nx release publish",
    "prerelease": "nx release --skip-publish --specifier=prerelease --preid=beta",
    "prerelease:no-push": "nx release --skip-publish --specifier=prerelease --preid=beta --git-commit=false --git-tag=false",
    "graduate": "nx release --skip-publish",
    "graduate:no-push": "nx release --skip-publish --git-commit=false --git-tag=false",
    "preminor": "nx release --skip-publish --specifier=preminor --preid=beta",
    "preminor:no-push": "nx release --skip-publish --specifier=preminor --preid=beta --git-commit=false --git-tag=false",
    "premajor": "nx release --skip-publish --specifier=premajor --preid=beta",
    "premajor:no-push": "nx release --skip-publish --specifier=premajor --preid=beta --git-commit=false --git-tag=false",
    "consumer-with-api:serve": "make consumer-with-api-serve",
    "test:unit": "nx run-many --target=test --all=true",
    "env:setup": "cp .env.example .env",
    "prisma:generate:postgres": "prisma generate --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma",
    "prisma:db:pull": "prisma db pull --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma",
    "prisma:migrate:dev:create-only": "prisma migrate dev --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma --create-only",
    "prisma:migrate:deploy": "prisma migrate deploy --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma",
    "prisma:studio": "prisma studio --schema teams/people/researchers/peers/adapters/src/database/infra/prisma/postgresql.schema.prisma",
    "start:example:mongoose": "pnpm env:setup && pnpm prisma:generate:postgres && nx run-many --target=serve --all=true",
    "start:example:prisma": "pnpm env:setup && pnpm prisma:generate:postgres && pnpm prisma:migrate:dev && nx run-many --target=serve --all=true",
    "build:researchers-peers-svc-rest-api": "pnpm prisma:generate:postgres && pnpm nx run researchers-peers-svc-rest-api:build",
    "build:service-consumer": "pnpm prisma:generate:postgres && pnpm nx run service-consumer:build",
    "researchers-peers-svc-rest-api:serve:production": "node dist/teams/researchers/peers/svc-rest-api/main.js",
    "researchers-peers-svc-rest-api:serve": "make researchers-peers-svc-rest-api-serve",
    "service-consumer:serve": "make service-consumer-serve",
    "start": "pnpm nx run-many --target=serve --all=true",
    "start:back-end": "nx run-many --target=serve --projects=researchers-peers-svc-rest-api,service-consumer --parallel --maxParallel=2",
    "e2e:back-end": "nx e2e core-peers-svc-e2e",
    "e2e:front-end": "nx e2e service-mfe-e2e",
    "generate-types": "pnpx ts-node --compilerOptions '{\"resolveJsonModule\":true}' teams/kernel/shared-ts-utils/src/types/type-generator.ts"
  },
